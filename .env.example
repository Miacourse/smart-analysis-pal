# Copiez ce fichier vers .env et renseignez vos valeurs.
# Les variables VITE_* sont exposées au navigateur (clés publiques uniquement).

SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Secrets côté serveur — à définir dans l'environnement d'hébergement, jamais dans le dépôt.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
LOVABLE_API_KEY=
